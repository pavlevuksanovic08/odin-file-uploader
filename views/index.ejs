<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>File Uploader</title>
</head>
<body>
    <h1>Welcome to the File Uploader</h1>
    <% if (locals.currentUser) { %>
        <p>You're logged in.</p>
        <form action="/upload" method="post" enctype="multipart/form-data">
            <label>Upload file:</label>
            <input type="file" name="file">
            <button type="submit">Upload</button>
        </form>
        <button onclick="window.location.href='/folder/create'">Create new folder</button>
        <% if (locals.folders) { %>
            <div class="folders">
                <% locals.folders.forEach(f => { %>
                    <div onclick="window.location.href='/folder/<%= f.id %>'">
                        <p><%= f.name %></p>
                    </div>
                <% }) %>
            </div>
        <% } %>

    <% } else { %>
        <p>You're not logged in.</p>
        <p>Please log in to upload files.</p>
        <button onclick="window.location.href = '/login';">Login</button>
        <p>Don't have an account?</p>
        <button onclick="window.location.href = '/signup';">Register</button>
    <% } %>
</body>
</html>