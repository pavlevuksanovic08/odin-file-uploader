<%
    function formatBytes(bytes, decimals = 2) {
        if (bytes === 0) return '0 Bytes';

        const k = 1024;
        const dm = decimals < 0 ? 0 : decimals;
        const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];

        // Matematički pronalazimo pravi indeks iz 'sizes' niza
        const i = Math.floor(Math.log(bytes) / Math.log(k));

        return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.folder.name %></title>
</head>
<body>
    <h1><%= locals.folder.name %></h1>
    <button onclick="window.location.href='/folder/<%=locals.folder.id %>/edit'">Edit folder</button>
    <form method="post" action="/folder/<%= locals.folder.id %>/delete" 
        onsubmit="return confirm('Are you sure you want to delete this folder permanently?')">
        <button type="submit">Delete folder</button>
    </form>
    <form action="/folder/<%= locals.folder.id %>/upload" method="post" enctype="multipart/form-data">
        <label>Upload file:</label>
        <input type="file" name="file">
        <button type="submit">Upload</button>
    </form>
    <% if (locals.files.length !== 0) { %>
        <table>
            <tr>
                <th>Name</th>
                <th>Size</th>
                <th>Created At</th>
                <th></th>
                <th></th>
            </tr>
            <% locals.files.forEach(f => { %>
                <tr>
                    <td><%= f.originalName %></td>
                    <td><%= formatBytes(f.size) %></td>
                    <td>
                        <time class="local-date" datetime="<%= f.createdAt.toISOString() %>">
                            Učitavam...
                        </time>
                    </td>                    
                    <td>
                        <form method="post" action="/file/<%= f.id %>/download">
                            <button type="submit">Download</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" action="/file/<%= f.id %>/delete">
                            <button type="submit">Download</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </table>
    <% } %>
    <script>
        document.querySelectorAll('.local-date').forEach(el => {
            const rawDate = new Date(el.getAttribute('datetime'));
            // 'undefined' automatski uzima jezik i zonu iz brauzera korisnika
            el.textContent = rawDate.toLocaleDateString(undefined, {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
            hour: '2-digit',
            minute: '2-digit'
            });
        });

        
        
    </script>
</body>
</html>