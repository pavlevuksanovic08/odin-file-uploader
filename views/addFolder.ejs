<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1><%= locals.folder ? 'Edit' : 'Create' %> folder</h1>
    <form method="post" action="<%= locals.folder ? '/folder/' + locals.folder.id + '/edit' : '/folder/create' %>">
        <label name="name">Name:</label>
        <input type="text" name="name" id="name" value="<%= locals.folder ? locals.folder.name : ''%>">
        <button type="submit"><%= locals.folder ? 'Edit' : 'Create' %></button>
    </form>
    <% if (locals.errors) {%>
        <% locals.errors.forEach(e => { %>
            <p><%= e.msg %></p>
        <%})%>
    <%}%>
</body>
</html>